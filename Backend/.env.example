ENVIRONMENT=development
DATABASE_HOST=localhost
DATABASE_PORT=55434
DATABASE_NAME=fanilo
DATABASE_USER=fanilo
DATABASE_PASSWORD=fanilo
# Required in production: a distinct read-only account granted only public_publications.
PUBLIC_DATABASE_URL=
DEFAULT_NEWSROOM_ID=1
DEFAULT_DATASET=real
PUBLIC_NEWSROOM_ID=1
PUBLIC_DATASET=real
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
# Prefer migrations. Enable only for disposable development databases.
AUTO_CREATE_TABLES=false
# Set a stable random secret (at least 32 bytes); mandatory in production.
JWT_SECRET=
JWT_EXPIRE_MINUTES=15
JWT_ISSUER=fa-ai-marinana
JWT_AUDIENCE=fa-ai-marinana-api
REFRESH_EXPIRE_DAYS=30
INVITATION_EXPIRE_HOURS=48
# Deprecated flag: registration always requires a single-use invitation.
ALLOW_PUBLIC_REGISTRATION=false
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:5173
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_SECONDS=45
SMS_BACKEND=simulation
# Per process/IP limits; add shared quotas at the reverse proxy for multiple workers.
AUTH_REQUESTS_PER_MINUTE=60
PUBLIC_REQUESTS_PER_MINUTE=60

# Independent Maharavo connector: inactive until a documented adapter exists.
# These variables alone do not create or discover an external API.
MAHARAVO_ENABLED=false
MAHARAVO_BASE_URL=
MAHARAVO_API_KEY=
MAHARAVO_ALLOWED_MODEL_VERSIONS=
MAHARAVO_CONNECT_TIMEOUT=10
MAHARAVO_READ_TIMEOUT=30
MAHARAVO_WRITE_TIMEOUT=10
MAHARAVO_POOL_TIMEOUT=5
MAHARAVO_TOTAL_TIMEOUT=90
MAHARAVO_MAX_ATTEMPTS=3
MAHARAVO_BACKOFF_SECONDS=0.5
MAHARAVO_MAX_BACKOFF_SECONDS=10
MAHARAVO_REQUESTS_PER_MINUTE=30
MAHARAVO_MAX_CONCURRENT_REQUESTS=2
MAHARAVO_MAX_REQUEST_BYTES=262144
MAHARAVO_MAX_RESPONSE_BYTES=524288
MAHARAVO_MAX_SOURCES=10
MAHARAVO_MAX_DOCUMENTS=5
MAHARAVO_MAX_EVIDENCE=20
MAHARAVO_MAX_CLAIMS=50
MAHARAVO_MAX_ANALYSIS_CHARS=50000
MAHARAVO_MAX_DRAFT_CHARS=20000
MAHARAVO_MAX_QUOTE_CHARS=5000
